# Gemini Developer API (local development)
GOOGLE_API_KEY=replace-with-your-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Required by the hackathon. Keep the model explicit for deployment evidence.
GEMINI_MODEL=gemini-3.5-flash

# local = SQLite; firestore = Google Cloud Firestore
REALITYCHECK_STORE=local
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
FIRESTORE_DATABASE=(default)
# External runtimes only: base64-encoded service-account JSON. Never commit its value.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Demo safety: outbound provider actions remain simulated unless explicitly changed.
PROVIDER_MODE=simulated
TASKS_SHARED_SECRET=replace-with-a-long-random-value
APP_ENV=development
